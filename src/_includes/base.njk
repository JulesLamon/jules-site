<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.shortName }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:image" content="{{ site.url }}/assets/img/jules-headshot.jpg">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
  <meta name="twitter:card" content="summary">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/">Jules Lamon</a>
      <nav aria-label="Main">
        {%- for item in navigation %}
        {%- if item.url != "/writing/" or collections.posts.length %}
        <a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endif %}
        {%- endfor %}
        <a class="btn-small" href="{{ site.resume }}">Résumé</a>
      </nav>
    </div>
  </header>
  <main id="main" class="wrap" tabindex="-1">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a> · <a href="{{ site.linkedin }}">LinkedIn</a>{% if site.github %} · <a href="{{ site.github }}">GitHub</a>{% endif %}</p>
      <p class="muted">© {{ build.year }} Julianna Lamon</p>
    </div>
  </footer>
</body>
</html>
